# Base URL of the Overex backend (Spring Boot).
# The frontend appends the API prefix itself, e.g. ${NEXT_PUBLIC_BACKEND_URL}/api/v1/auth/sign-in
#
# Defaults to http://localhost:8080 in code, so you only need this file if your
# backend runs elsewhere. Copy it to .env.local and adjust.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
