{
  "name": "overex-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:workflows": "docker run --rm -v \"$(git rev-parse --show-toplevel):/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "act:all": "bash ../../scripts/act-all.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e:db-up": "docker compose -f ../../docker-compose.test.yml up -d",
    "e2e:db-down": "docker compose -f ../../docker-compose.test.yml down",
    "e2e:backend": "cd ../backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=e2e",
    "e2e:web": "cross-env NEXT_PUBLIC_BACKEND_URL=http://localhost:8081 NEXT_DIST_DIR=.next-e2e next build && cross-env NEXT_DIST_DIR=.next-e2e next start -p 3001",
    "test:e2e": "sh scripts/run-e2e.sh",
    "test:e2e:ui": "sh scripts/run-e2e.sh --ui",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-countdown": "2.3.6",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.2.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
