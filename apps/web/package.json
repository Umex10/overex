{
  "name": "overex-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e:db-up": "docker compose -f ../../docker-compose.test.yml up -d",
    "e2e:db-down": "docker compose -f ../../docker-compose.test.yml down",
    "e2e:backend": "cd ../backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=e2e",
    "e2e:web": "cross-env NEXT_PUBLIC_BACKEND_URL=http://localhost:8081 NEXT_DIST_DIR=.next-e2e next build && cross-env NEXT_DIST_DIR=.next-e2e next start -p 3001",
    "test:e2e": "npm run e2e:db-up && playwright test; status=$?; fuser -k 8081/tcp 2>/dev/null; npm run e2e:db-down; exit $status",
    "test:e2e:ui": "npm run e2e:db-up && playwright test --ui; status=$?; fuser -k 8081/tcp 2>/dev/null; npm run e2e:db-down; exit $status",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "react-redux": "^9.2.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
